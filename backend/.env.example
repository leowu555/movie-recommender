# Copy to backend/.env and fill in values. Never commit .env.
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Required
SECRET_KEY=replace-with-generated-django-secret-key
TMDB_API_KEY=your_tmdb_api_key_here

# Optional (DEBUG defaults to false if omitted)
DEBUG=true

# Comma-separated. Omit to use localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins for the Vite dev server.
# Omit to allow localhost/127.0.0.1 on ports 5173-5175.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Optional. Token-authenticated API calls do not use CSRF; set this if you use session/admin from another origin.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

DB_NAME=movie_recommender
DB_USER=your_mac_username
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
